# ============================================================
#  Katalog instalacyjny - CALKOWICIE niedostepny z WWW.
#  Zawiera skrypty instalacyjne i pliki SQL z danymi bazy.
# ============================================================

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (fallback)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Nie udostepniaj zawartosci katalogu (bez listy plikow).
Options -Indexes
